{
  "name": "YouTube",
  "short_name": "YouTube",
  "description": "Watch YouTube videos with clean guardrails and safe recommendations.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0F0F0F",
